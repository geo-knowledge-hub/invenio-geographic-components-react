{
  "name": "@geo-knowledge-hub/invenio-geographic-components-react",
  "version": "1.0.0",
  "description": "React components to visualize and manipulate geographic data in InvenioRDM.",
  "private": true,
  "config": {
    "languages": [
      "en"
    ]
  },
  "scripts": {
    "build": "rimraf python/invenio_geographic_components/static python/invenio_geographic_components/assets && NODE_ENV=production rollup -c",
    "watch": "NODE_ENV=development rollup --watch -c",
    "test": "react-scripts test",
    "lint": "eslint src/**/*.js",
    "format": "prettier --config ./.prettierrc --write \"src/**/*.js\"",
    "extract_messages": "i18next-scanner --config i18next-scanner.config.js 'src/**/*.{js,jsx}'",
    "postextract_messages": "i18next-conv -l en -s ./src/lib/translations/messages/en/translations.json -t ./src/lib/translations/translations.pot",
    "compile_catalog": "node ./src/lib/translations/scripts/compileCatalog.js",
    "init_catalog": "node ./src/lib/translations/scripts/initCatalog",
    "storybook": "storybook dev -p 6006",
    "storybook-build": "storybook build",
    "storybook-jest": "jest --json --outputFile=.jest-test-results.json || true"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.22.0",
    "@babel/preset-react": "^7.22.0",
    "@emotion/react": "^11.9.0",
    "@geoman-io/leaflet-geoman-free": "^2.13.0",
    "@mapbox/geojsonhint": "^3.0.1",
    "@react-leaflet/core": "1.0.2",
    "@rollup/plugin-alias": "^3.1.0",
    "@rollup/plugin-babel": "^5.0.0",
    "@rollup/plugin-commonjs": "^22.0.0",
    "@rollup/plugin-json": "^4.1.0",
    "@rollup/plugin-node-resolve": "^13.3.0",
    "@rollup/plugin-replace": "^4.0.0",
    "@rollup/plugin-url": "^7.0.0",
    "@semantic-ui-react/css-patch": "^1.1.3",
    "@storybook/addon-actions": "8.6.18",
    "@storybook/addon-essentials": "8.6.18",
    "@storybook/addon-interactions": "8.6.18",
    "@storybook/addon-jest": "8.6.18",
    "@storybook/addon-links": "8.6.18",
    "@storybook/react": "8.6.18",
    "@storybook/react-webpack5": "^8.6.18",
    "@storybook/test": "^8.6.18",
    "@testing-library/jest-dom": "^4.2.0",
    "@testing-library/react": "^9.5.0",
    "@testing-library/user-event": "^7.2.0",
    "@turf/bbox": "^6.5.0",
    "@turf/bbox-polygon": "^6.5.0",
    "@turf/centroid": "^6.5.0",
    "@turf/convex": "^6.5.0",
    "ajv": "^8.8.2",
    "axios": "^1.7.0",
    "babel-preset-react-app": "^10.0.1",
    "cssnano": "^5.1.15",
    "formik": "^2.1.0",
    "i18next": "^20.3.0",
    "i18next-browser-languagedetector": "^6.1.0",
    "i18next-conv": "^10.2.0",
    "i18next-scanner": "^3.0.0",
    "jest-watch-typeahead": "^0.4.2",
    "leaflet": "^1.7.1",
    "leaflet-control-geocoder": "^2.4.0",
    "leaflet.fullscreen": "^1.6.0",
    "lodash": "^4.17.0",
    "luxon": "^1.28.1",
    "object-hash": "^3.0.0",
    "postcss": "^8.4.6",
    "postcss-url": "^10.1.3",
    "prettier": "^2.7.1",
    "prop-types": "^15.8.1",
    "query-string": "^7.1.1",
    "react": "^16.13.0",
    "react-dnd": "^11.1.0",
    "react-dnd-html5-backend": "^11.1.0",
    "react-dom": "^16.13.0",
    "react-i18next": "^11.11.0",
    "react-invenio-forms": "^4.0.0",
    "react-leaflet": "3.1.0",
    "react-overridable": "^1.0.0",
    "react-scripts": "^5.0.1",
    "react-semantic-toasts": "^0.6.6",
    "rimraf": "^3.0.0",
    "rollup": "^2.79.0",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-terser": "^7.0.2",
    "semantic-ui-css": "^2.4.0",
    "semantic-ui-react": "^2.1.0",
    "storybook": "8.6.18",
    "storybook-addon-mock": "^5.0.0",
    "yup": "^0.32.11"
  },
  "overrides": {
    "eslint": {
      "ajv": "^6.12.4"
    }
  },
  "author": {
    "name": "GEO Knowledge Hub team",
    "email": "pdsalvo@geosec.org"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/geo-knowledge-hub/invenio-geographic-components-react.git"
  },
  "bugs": {
    "url": "https://github.com/geo-knowledge-hub/invenio-geographic-components-react/issues"
  },
  "license": "MIT",
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not op_mini all"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "jest": {
    "moduleNameMapper": {
      "@translations/i18next": "<rootDir>/src/lib/i18next",
      "@tests/setup": "<rootDir>/src/setupTests",
      "@tests/mock/(.*)/(.*)": "<rootDir>/src/mocks/$1/$2",
      "^tinymce(/.*)?$": "<rootDir>/src/mocks/tinymce",
      "^@tinymce/tinymce-react$": "<rootDir>/src/mocks/tinymce"
    },
    "transformIgnorePatterns": [
      "[/\\\\]node_modules[/\\\\](?!(@turf|@mapbox|react-leaflet|@react-leaflet|concaveman|rbush|tinyqueue|quickselect|robust-predicates)[/\\\\]).+\\.(js|mjs|jsx|ts|tsx)$",
      "^.+\\.module\\.(css|sass|scss)$"
    ]
  }
}
